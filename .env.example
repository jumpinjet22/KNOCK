# Copy to .env and fill in for your setup. Nothing here is required --
# every value has a sane localhost default (see knock/config.py); this file
# only matters once you're pointing KNOCK at real services on your network.
#
# Load it into your shell before running the CLI/API/bridges:
#   set -a && source .env && set +a
# or pass it to Docker Compose:
#   docker compose -f docker/compose.local.yml --env-file .env up --build

# --- Ollama (LLM + Vision) ---
KNOCK_OLLAMA_HOST=127.0.0.1
KNOCK_OLLAMA_PORT=11434
KNOCK_OLLAMA_MODEL=llama3.2
# KNOCK_OLLAMA_TIMEOUT=30.0
# Keep the model loaded between rings (-1 = forever). Unset = Ollama's own
# default, which unloads after 5 idle minutes.
# KNOCK_OLLAMA_KEEP_ALIVE=-1
# Optional second-opinion safety model, optionally on its own Ollama server
# (defaults to KNOCK_OLLAMA_HOST/PORT when unset).
# KNOCK_OLLAMA_SAFETY_CHECK_MODEL=
# KNOCK_OLLAMA_SAFETY_CHECK_HOST=
# KNOCK_OLLAMA_SAFETY_CHECK_PORT=

KNOCK_VISION_HOST=127.0.0.1
KNOCK_VISION_PORT=11434
KNOCK_VISION_MODEL=moondream
# KNOCK_VISION_TIMEOUT=30.0
# KNOCK_VISION_PROMPT=
# KNOCK_VISION_KEEP_ALIVE=-1
# Opt-in: also send the raw snapshot to a multimodal main model (see README).
# KNOCK_VISION_SEND_IMAGE_TO_BRAIN=false

# --- Whisper (STT, Wyoming protocol) ---
KNOCK_WHISPER_HOST=127.0.0.1
KNOCK_WHISPER_PORT=10300
# KNOCK_WHISPER_TIMEOUT=10.0

# --- Kokoro (TTS, Wyoming protocol) ---
KNOCK_KOKORO_HOST=127.0.0.1
KNOCK_KOKORO_PORT=10200
# KNOCK_KOKORO_VOICE=
# KNOCK_KOKORO_TIMEOUT=10.0

# --- MQTT bridge ---
# KNOCK_MQTT_HOST=127.0.0.1
# KNOCK_MQTT_PORT=1883
# KNOCK_MQTT_CLIENT_ID=knock
# KNOCK_MQTT_TOPIC_IN=knock/events
# KNOCK_MQTT_TOPIC_OUT=knock/responses
# KNOCK_MQTT_USERNAME=
# KNOCK_MQTT_PASSWORD=
# KNOCK_MQTT_KEEPALIVE=60

# --- Frigate bridge ---
# KNOCK_FRIGATE_MQTT_HOST=127.0.0.1
# KNOCK_FRIGATE_MQTT_PORT=1883
# KNOCK_FRIGATE_TOPIC_PREFIX=frigate
# KNOCK_FRIGATE_TOPIC_OUT=knock/responses
# KNOCK_FRIGATE_HTTP_HOST=127.0.0.1
# KNOCK_FRIGATE_HTTP_PORT=5000
# KNOCK_FRIGATE_TRIGGER_LABELS=person
# KNOCK_FRIGATE_ZONES=
# KNOCK_FRIGATE_USERNAME=
# KNOCK_FRIGATE_PASSWORD=

# --- Home Assistant bridge ---
# Create a Long-Lived Access Token in your HA user profile for the token.
# KNOCK_HA_BASE_URL=http://homeassistant.local:8123
# KNOCK_HA_TOKEN=
# KNOCK_HA_TRIGGER_ENTITY_ID=binary_sensor.front_doorbell
# KNOCK_HA_NOTIFY_SERVICE=
# KNOCK_HA_VERIFY_SSL=true

# --- UniFi Protect bridge ---
# Create an API key for a local console user (cloud SSO/MFA not supported).
# KNOCK_UNIFI_HOST=127.0.0.1
# KNOCK_UNIFI_PORT=443
# KNOCK_UNIFI_API_KEY=
# Optional: the same local user's login, alongside the API key. Only needed
# for Protect's own recorded clips (with pre-roll) on package removal alerts.
# KNOCK_UNIFI_USERNAME=
# KNOCK_UNIFI_PASSWORD=
# KNOCK_UNIFI_VERIFY_SSL=false
# KNOCK_UNIFI_TRIGGER_ON=ring
# KNOCK_UNIFI_RTSP_QUALITY=high
# KNOCK_UNIFI_LISTEN_SECONDS=10.0
# Stop listening after this much quiet once the visitor has spoken (0 = off).
# KNOCK_UNIFI_END_SILENCE_SECONDS=1.0
# Package alerts (needs package detection on in Protect).
# KNOCK_UNIFI_PACKAGE_ALERTS=true
# KNOCK_UNIFI_PACKAGE_REMINDER_HOURS=0
# KNOCK_UNIFI_PACKAGE_REMOVAL_ALERTS=true
# KNOCK_UNIFI_PACKAGE_CLIP_SECONDS=30
# KNOCK_UNIFI_PACKAGE_CLIP_PREROLL_SECONDS=10
# KNOCK_PACKAGE_LOG=~/.local/share/knock/package_events.jsonl
# KNOCK_PACKAGE_MEDIA_DIR=~/.local/share/knock/package_media

# --- Phone calls (SIP) ---
# Ring a phone for important notifications (see README "Phone calls (SIP)").
# Uses baresip (included in the Docker image). Needs host networking in Docker.
# KNOCK_SIP_ENABLED=false
# KNOCK_SIP_SERVER=
# KNOCK_SIP_PORT=5060
# KNOCK_SIP_USERNAME=
# KNOCK_SIP_PASSWORD=
# KNOCK_SIP_REGISTRATION=true
# KNOCK_SIP_CALL_TARGETS=
# KNOCK_SIP_CALL_ON=emergency
# KNOCK_SIP_RING_TIMEOUT_SECONDS=30
# KNOCK_SIP_CALL_COOLDOWN_SECONDS=300
# KNOCK_SIP_LOCAL_IP=
# KNOCK_SIP_LOCAL_SIP_PORT=5060
# KNOCK_SIP_RTP_PORT_LOW=10000
# KNOCK_SIP_RTP_PORT_HIGH=10100
# KNOCK_SIP_BARESIP_PATH=baresip
# KNOCK_SIP_BARESIP_CTRL_PORT=4444
# KNOCK_SIP_BARESIP_MODULE_PATH=
# KNOCK_BARESIP_DIR=~/.local/share/knock/baresip

# --- Session persistence & audit trail ---
# KNOCK_SESSION_DIR=~/.local/share/knock/sessions
# KNOCK_AUDIT_LOG=~/.local/share/knock/audit.jsonl
