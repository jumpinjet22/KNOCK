# KNOCK across machines -- copy to knock.env (next to knock.yml) and replace
# the example LAN addresses. Same KNOCK_* variables as the repo-root
# .env.example; anything set here wins over the web UI's stored settings.

# --- Brain box (brain.yml, e.g. RTX 2060 Super) ---
KNOCK_OLLAMA_HOST=192.168.1.20
KNOCK_OLLAMA_PORT=11434
KNOCK_OLLAMA_MODEL=qwen3.5:9b
KNOCK_OLLAMA_KEEP_ALIVE=-1

# Vision: a multimodal brain model does vision too -- same box, same model,
# so only one model is ever loaded. To use a dedicated small vision model on
# the assist box instead, point these at it and set KNOCK_ASSIST_VISION_MODEL
# when starting assist.yml.
KNOCK_VISION_HOST=192.168.1.20
KNOCK_VISION_PORT=11434
KNOCK_VISION_MODEL=qwen3.5:9b
KNOCK_VISION_KEEP_ALIVE=-1
# Opt-in: also send the raw snapshot to the (multimodal) brain -- see README.
# KNOCK_VISION_SEND_IMAGE_TO_BRAIN=false

# --- Assist box (assist.yml, e.g. GTX 1660) ---
KNOCK_OLLAMA_SAFETY_CHECK_MODEL=qwen3:1.7b
KNOCK_OLLAMA_SAFETY_CHECK_HOST=192.168.1.21
KNOCK_OLLAMA_SAFETY_CHECK_PORT=11434

KNOCK_WHISPER_HOST=192.168.1.21
KNOCK_WHISPER_PORT=10300
KNOCK_KOKORO_HOST=192.168.1.21
KNOCK_KOKORO_PORT=10210

# --- Camera bridge (fill in whichever you use; see the repo-root .env.example) ---
# KNOCK_UNIFI_HOST=192.168.1.1
# KNOCK_UNIFI_API_KEY=
# KNOCK_FRIGATE_MQTT_HOST=
# KNOCK_HA_BASE_URL=
# KNOCK_HA_TOKEN=
